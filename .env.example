# Copy this file to .env. Values below are for local development only.
# Replace every password before sharing or deploying the project.

COMPOSE_PROJECT_NAME=transitpulse

# Container images
KAFKA_IMAGE=apache/kafka:4.3.1
SPARK_IMAGE=apache/spark:4.2.0-scala2.13-java17-python3-ubuntu
POSTGRES_IMAGE=postgres:17.10-alpine
AIRFLOW_IMAGE=apache/airflow:3.1.4-python3.12
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
PYTHON_IMAGE=python:3.12-slim

# PostgreSQL local development
POSTGRES_DB=transitpulse
POSTGRES_USER=transitpulse_admin
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_HOST_PORT=5432

# Airflow local development
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-airflow
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=

# MBTA open-data feeds; API key is not required for the CDN GTFS feeds.
MBTA_API_KEY=
MBTA_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
MBTA_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
MBTA_ALERTS_URL=https://cdn.mbta.com/realtime/Alerts.pb
MBTA_GTFS_STATIC_URL=https://cdn.mbta.com/MBTA_GTFS.zip
MBTA_POLL_INTERVAL_SECONDS=30

# Kafka
KAFKA_EXTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_RETENTION_MS=604800000
KAFKA_DLQ_RETENTION_MS=2592000000

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_CHECKPOINT_ROOT=/opt/spark/checkpoints

# Dashboard and application
DASHBOARD_PORT=8501
APP_TIMEZONE=America/New_York
LOG_LEVEL=INFO
APP_CONFIG_PATH=/app/configs/app.example.yaml
ROUTES_CONFIG_PATH=/app/configs/routes.example.yaml
THRESHOLDS_CONFIG_PATH=/app/configs/thresholds.yaml
